let int = import("int");

dumpln(int::u8::add_wrapped(1, 2));
dumpln(int::u8::add_wrapped(int::u8::MAX, 1));

print("\n");

dumpln(int::s8::add_wrapped(-1, 2));
dumpln(int::s8::add_wrapped(int::s8::MAX, +1));
dumpln(int::s8::add_wrapped(int::s8::MIN, -1));
