dumpln(int::s8::wrapped(+0xFF));
dumpln(int::s8::wrapped(+0x100));
dumpln(int::s8::wrapped(-0x12));
dumpln(int::s8::wrapped(-0xFF));
dumpln(int::s8::wrapped(-0x100));
