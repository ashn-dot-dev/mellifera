let int = import("int");

dumpln(int::u8::wrapped(+0));
dumpln(int::u8::wrapped(+0x12));
dumpln(int::u8::wrapped(+0xFF));
dumpln(int::u8::wrapped(+0x100));
dumpln(int::u8::wrapped(-0x12));
dumpln(int::u8::wrapped(-0xFF));
dumpln(int::u8::wrapped(-0x100));

print("\n");

dumpln(int::s8::wrapped(+0));
