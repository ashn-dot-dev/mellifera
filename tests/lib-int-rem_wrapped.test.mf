let int = import("int");

dumpln(int::u8::rem_wrapped(9, 2));
try { int::u8::rem_wrapped(1, 0); } catch err { dumpln(err); }

print("\n");

dumpln(int::s8::rem_wrapped(9, +2));
dumpln(int::s8::rem_wrapped(9, -2));
try { int::s8::rem_wrapped(1, 0); } catch err { dumpln(err); }
dumpln(int::s8::rem_wrapped(int::s8::MIN, -1));
