let int = import("int");

println(int::u8::bit_and(0b10101100, 0b11110000).format("08b"));
println(int::u8::bit_and(int::u8::MIN, 0b11110000).format("08b"));
println(int::u8::bit_and(int::u8::MAX, 0b11110000).format("08b"));
println(int::s8::bit_and(int::s8::MAX, 0b01110000).format("08b"));

print("\n");

dumpln(int::s8::bit_and(-1, -128));
dumpln(int::s8::bit_and(-1, 0b01010101));
dumpln(int::s8::bit_and(-2, -3));
dumpln(int::s8::bit_and(int::s8::MIN, int::s8::MAX));
