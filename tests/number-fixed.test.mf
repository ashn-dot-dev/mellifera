println($`(123.456789).fixed(0) is {(123.456789).fixed(0)}`);
println($`(123.456789).fixed(1) is {(123.456789).fixed(1)}`);
println($`(123.456789).fixed(2) is {(123.456789).fixed(2)}`);
println($`(123.456789).fixed(3) is {(123.456789).fixed(3)}`);
println($`(123.456789).fixed(4) is {(123.456789).fixed(4)}`);
println($`(123.456789).fixed(5) is {(123.456789).fixed(5)}`);
println($`(123.456789).fixed(6) is {(123.456789).fixed(6)}`);
println($`(123.456789).fixed(7) is {(123.456789).fixed(7)}`);
println($`(123.456789).fixed(8) is {(123.456789).fixed(8)}`);

print("\n");

println($`NaN.fixed(3) is {NaN.fixed(3)}`);
println($`(+Inf).fixed(3) is {(+Inf).fixed(3)}`);
println($`(-Inf).fixed(3) is {(-Inf).fixed(3)}`);
println($`(+0.5).fixed(0) is {(+0.5).fixed(0)}`);
println($`(-0.5).fixed(0) is {(-0.5).fixed(0)}`);
println($`(+1.5).fixed(0) is {(+1.5).fixed(0)}`);
println($`(-1.5).fixed(0) is {(-1.5).fixed(0)}`);
println($`(+1.25).fixed(1) is {(+1.25).fixed(1)}`);
println($`(-1.25).fixed(1) is {(-1.25).fixed(1)}`);

print("\n");

try { (123.456789).fixed(-1); } catch err { println($`(123.456789).fixed(-1) produced the error {repr(err)}`); }
try { (123.456789).fixed(3.14); } catch err { println($`(123.456789).fixed(3.14) produced the error {repr(err)}`); }
try { (123.456789).fixed(NaN); } catch err { println($`(123.456789).fixed(NaN) produced the error {repr(err)}`); }
try { (123.456789).fixed(-math::pow(2, 100)); } catch err { println($`(123.456789).fixed(-math::pow(2, 100)) produced the error {repr(err)}`); }
try { (123.456789).fixed(+math::pow(2, 100)); } catch err { println($`(123.456789).fixed(+math::pow(2, 100)) produced the error {repr(err)}`); }
################################################################################
# (123.456789).fixed(0) is 123
# (123.456789).fixed(1) is 123.5
# (123.456789).fixed(2) is 123.46
# (123.456789).fixed(3) is 123.457
# (123.456789).fixed(4) is 123.4568
# (123.456789).fixed(5) is 123.45679
# (123.456789).fixed(6) is 123.456789
# (123.456789).fixed(7) is 123.456789
# (123.456789).fixed(8) is 123.456789
#
# NaN.fixed(3) is NaN
# (+Inf).fixed(3) is Inf
# (-Inf).fixed(3) is -Inf
# (+0.5).fixed(0) is 1
# (-0.5).fixed(0) is -1
# (+1.5).fixed(0) is 2
# (-1.5).fixed(0) is -2
# (+1.25).fixed(1) is 1.3
# (-1.25).fixed(1) is -1.3
#
# (123.456789).fixed(-1) produced the error "expected non-negative integer, received -1"
# (123.456789).fixed(3.14) produced the error "cannot convert 3.14 into an integer without truncation"
# (123.456789).fixed(NaN) produced the error "cannot convert NaN into an integer"
# (123.456789).fixed(-math::pow(2, 100)) produced the error "integer -1267650600228229401496703205376 is outside the safe integer range"
# (123.456789).fixed(+math::pow(2, 100)) produced the error "integer 1267650600228229401496703205376 is outside the safe integer range"
