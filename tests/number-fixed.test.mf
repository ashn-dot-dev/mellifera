println($`Inf.fixed(2) is {Inf.fixed(2)}`);
println($`(-Inf).fixed(2) is {(-Inf).fixed(2)}`);
println($`NaN.fixed(2) is {NaN.fixed(2)}`);
println($`1.0 / ((-0.1).fixed(0)) is {1.0 / ((-0.1).fixed(0))}`);
println($`1.0 / ((0.1).fixed(0)) is {1.0 / ((0.1).fixed(0))}`);
try { (123.456789).fixed(-1); } catch err { println($`(123.456789).fixed(-1) produced the error {repr(err)}`); }
try { (123.456789).fixed(3.14); } catch err { println($`(123.456789).fixed(3.14) produced the error {repr(err)}`); }
try { (123.456789).fixed(NaN); } catch err { println($`(123.456789).fixed(NaN) produced the error {repr(err)}`); }
try { (123.456789).fixed(-math::pow(2, 100)); } catch err { println($`(123.456789).fixed(-math::pow(2, 100)) produced the error {repr(err)}`); }
try { (123.456789).fixed(+math::pow(2, 100)); } catch err { println($`(123.456789).fixed(+math::pow(2, 100)) produced the error {repr(err)}`); }
