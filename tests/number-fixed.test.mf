println($`(-123.455).fixed(2) is {(-123.455).fixed(2)}`);
println($`(0.125).fixed(2) is {(0.125).fixed(2)}`);
println($`(2.5).fixed(0) is {(2.5).fixed(0)}`);
println($`(-2.5).fixed(0) is {(-2.5).fixed(0)}`);
println($`(1.25).fixed(1) is {(1.25).fixed(1)}`);
println($`(0.045).fixed(2) is {(0.045).fixed(2)}`);
