dumpln(range(1, 4).map(function(n) { return [n, math::pow(n, 2)]; }).into_map());
dumpln(range(1, 5).map(function(n) { return [n, math::pow(n, 2)]; }).into_map());
dumpln(range(1, 6).map(function(n) { return [n, math::pow(n, 2)]; }).into_map());
