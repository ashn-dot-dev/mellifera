let int = import("int");

dumpln(int::u8::mul2(1, 1));
dumpln(int::u8::mul2(1, 2));
dumpln(int::u8::mul2(int::u8::MAX, 2));
dumpln(int::u8::mul2(int::u8::MAX, int::u8::MAX));

print("\n");

dumpln(int::u16::mul2(1, 1));
dumpln(int::u16::mul2(1, 2));
dumpln(int::u16::mul2(int::u16::MAX, 2));
dumpln(int::u16::mul2(int::u16::MAX, int::u16::MAX));

print("\n");

dumpln(int::u32::mul2(1, 1));
dumpln(int::u32::mul2(1, 2));
dumpln(int::u32::mul2(int::u32::MAX, 2));
dumpln(int::u32::mul2(int::u32::MAX, int::u32::MAX));

print("\n");

dumpln(int::s8::mul2(+1, +1));
dumpln(int::s8::mul2(+1, +2));
dumpln(int::s8::mul2(+1, -1));
dumpln(int::s8::mul2(+1, -2));
dumpln(int::s8::mul2(int::s8::MAX, +2));
dumpln(int::s8::mul2(int::s8::MAX, -2));
dumpln(int::s8::mul2(int::s8::MAX, int::s8::MAX));
dumpln(int::s8::mul2(int::s8::MIN, int::s8::MAX));

print("\n");

dumpln(int::s16::mul2(+1, +1));
dumpln(int::s16::mul2(+1, +2));
dumpln(int::s16::mul2(+1, -1));
dumpln(int::s16::mul2(+1, -2));
dumpln(int::s16::mul2(int::s16::MAX, +2));
dumpln(int::s16::mul2(int::s16::MAX, -2));
dumpln(int::s16::mul2(int::s16::MAX, int::s16::MAX));
dumpln(int::s16::mul2(int::s16::MIN, int::s16::MAX));

print("\n");

dumpln(int::s32::mul2(+1, +1));
dumpln(int::s32::mul2(+1, +2));
dumpln(int::s32::mul2(+1, -1));
dumpln(int::s32::mul2(+1, -2));
dumpln(int::s32::mul2(int::s32::MAX, +2));
dumpln(int::s32::mul2(int::s32::MAX, -2));
dumpln(int::s32::mul2(int::s32::MAX, int::s32::MAX));
dumpln(int::s32::mul2(int::s32::MIN, int::s32::MAX));
