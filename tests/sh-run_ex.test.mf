dumpln(sh::run_ex(`grep 'input line' && printf "sh::run_ex stdout\n" && printf "sh::run_ex stderr\n" >&2 && true`, {.stdin = "input line 1\ninput line2\n"}));
dumpln(sh::run_ex(`grep 'input line' && printf "sh::run_ex stdout\n" && printf "sh::run_ex stderr\n" >&2 && false`, {.stdin = "input line 1\ninput line2\n"}));

print("\n");

dumpln(sh::run_ex(`kill -TERM $$`, Map{}));

print("\n");

try { dumpln(sh::run_ex(`printf 'empty options\n'`, Map{})); } catch err { println($"error: {err}"); }
try { dumpln(sh::run_ex(`printf 'invalid options\n'`, Set{})); } catch err { println($"error: {err}"); }
try { dumpln(sh::run_ex(`printf 'invalid option\n'`, {.foo = "bar"})); } catch err { println($"error: {err}"); }
try { dumpln(sh::run_ex(`printf 'invalid option\n'`, {.stdin = null})); } catch err { println($"error: {err}"); }
