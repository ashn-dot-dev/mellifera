let int = import("int");

println(int::big::abs(0));
println(int::big::abs(+1));
println(int::big::abs(-1));

print("\n");

println(int::big::abs(+123));
println(int::big::abs(-123));

print("\n");

println(int::big::abs("+123123123123123123123123123123"));
println(int::big::abs("-123123123123123123123123123123"));
