dumpln(int::s8::clamped(+0xFF));
dumpln(int::s8::clamped(+0x100));
dumpln(int::s8::clamped(-0x12));
dumpln(int::s8::clamped(-0xFF));
dumpln(int::s8::clamped(-0x100));
