let int = import("int");

println(int::big::mul(0, 0));
println(int::big::mul(0, +1));
println(int::big::mul(0, -1));
println(int::big::mul(+1, +1));
println(int::big::mul(-1, -1));
println(int::big::mul(+1, -1));

print("\n");

println(int::big::mul(+123, +456));
println(int::big::mul(+123, -456));
println(int::big::mul(-123, +456));
println(int::big::mul(-123, -456));

print("\n");

println(int::big::mul("+123123123123123123123123123123", "+456456456456456456456"));
println(int::big::mul("+123123123123123123123123123123", "-456456456456456456456"));
println(int::big::mul("-123123123123123123123123123123", "+456456456456456456456"));
println(int::big::mul("-123123123123123123123123123123", "-456456456456456456456"));
println(int::big::mul("+0xFFFFFFFFFFFFFFFFFFFFFFFF", "+0xFFFFFFFFFFFFFFFFFFFFFFFF").format("#x"));
