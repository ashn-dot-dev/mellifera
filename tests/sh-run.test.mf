dumpln(sh::run(`printf "sh::run stdout\n" && printf "sh::run stderr\n" >&2 && true`));
dumpln(sh::run(`printf "sh::run stdout\n" && printf "sh::run stderr\n" >&2 && false`));

print("\n");

dumpln(sh::run(`kill -TERM $$`));
