let int = import("int");

dumpln(int::u8::shiftl_checked(+0, 0));
dumpln(int::u8::shiftl_checked(+1, 0));
dumpln(int::u8::shiftl_checked(+0, 1));
dumpln(int::u8::shiftl_checked(+1, 1));
dumpln(int::u8::shiftl_checked(+1, 2));

print("\n");

dumpln(int::s8::shiftl_checked(+0, 0));
dumpln(int::s8::shiftl_checked(+1, 0));
dumpln(int::s8::shiftl_checked(+0, 1));
dumpln(int::s8::shiftl_checked(+1, 1));
dumpln(int::s8::shiftl_checked(+1, 2));
dumpln(int::s8::shiftl_checked(-1, 0));
dumpln(int::s8::shiftl_checked(-1, 1));
dumpln(int::s8::shiftl_checked(-1, 2));

print("\n");

try { int::u8::shiftl_checked(math::pow(2, 7), 1); } catch err { dumpln(err); }
try { int::u8::shiftl_checked(+1, 10); } catch err { dumpln(err); }
try { int::s8::shiftl_checked(-1, 10); } catch err { dumpln(err); }
try { int::u8::shiftl_checked(+0, -1); } catch err { dumpln(err); }
try { int::s8::shiftl_checked(+0, -1); } catch err { dumpln(err); }
