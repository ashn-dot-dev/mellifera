let int = import("int");

dumpln(int::u8::shiftr_checked(+0, 0));
dumpln(int::u8::shiftr_checked(+1, 0));
dumpln(int::u8::shiftr_checked(+0, 1));
dumpln(int::u8::shiftr_checked(+1, 1));
dumpln(int::u8::shiftr_checked(+1, 2));
dumpln(int::u8::shiftr_checked(+4, 1));

print("\n");

dumpln(int::s8::shiftr_checked(+0, 0));
dumpln(int::s8::shiftr_checked(+1, 0));
dumpln(int::s8::shiftr_checked(+0, 1));
dumpln(int::s8::shiftr_checked(+1, 1));
dumpln(int::s8::shiftr_checked(+1, 2));
dumpln(int::s8::shiftr_checked(+4, 1));
dumpln(int::s8::shiftr_checked(-1, 0));
dumpln(int::s8::shiftr_checked(-1, 1));
dumpln(int::s8::shiftr_checked(-1, 2));
dumpln(int::s8::shiftr_checked(-4, 1));

print("\n");

try { int::u8::shiftr_checked(+0, -1); } catch err { dumpln(err); }
try { int::s8::shiftr_checked(+0, -1); } catch err { dumpln(err); }
