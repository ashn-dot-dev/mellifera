try { dumpln(sh::runx(`printf "sh::runx stdout\n" && printf "sh::runx stderr\n" >&2 && true`)); } catch err { println($"error: {err}"); }
try { dumpln(sh::runx(`printf "sh::runx stdout\n" && printf "sh::runx stderr\n" >&2 && false`)); } catch err { println($"error: {err}"); }
