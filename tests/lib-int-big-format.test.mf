let int = import("int");

# d formatting
println($`int::big::init(0).format("d") is {repr(int::big::init(0).format("d"))}`);
println($`int::big::init("+123123123123123123123123123123").format("d") is {repr(int::big::init("+123123123123123123123123123123").format("d"))}`);
println($`int::big::init("-123123123123123123123123123123").format("d") is {repr(int::big::init("-123123123123123123123123123123").format("d"))}`);

print("\n");

println($`int::big::init(0).format("+d") is {repr(int::big::init(0).format("+d"))}`);
println($`int::big::init("+123123123123123123123123123123").format("+d") is {repr(int::big::init("+123123123123123123123123123123").format("+d"))}`);
println($`int::big::init("-123123123123123123123123123123").format("+d") is {repr(int::big::init("-123123123123123123123123123123").format("+d"))}`);

print("\n");

