# invalid format strings
try { int::big::init(0).format(""); error "unreachable"; } catch err { println($`int::big::init(0).format("") produced the error {repr(err)}`); }
try { int::big::init(0).format("oops"); error "unreachable"; } catch err { println($`int::big::init(0).format("oops") produced the error {repr(err)}`); }
try { int::big::init(0).format("+#08"); error "unreachable"; } catch err { println($`int::big::init(0).format("+#08") produced the error {repr(err)}`); }
try { int::big::init(0).format("f"); error "unreachable"; } catch err { println($`int::big::init(0).format("f") produced the error {repr(err)}`); }
try { int::big::init(0).format(".3d"); error "unreachable"; } catch err { println($`int::big::init(0).format(".3d") produced the error {repr(err)}`); }

print("\n");

# invalid big integers
try { int::big::format(+3.14, "d"); error "unreachable"; } catch err { println($`int::big::format(+3.14, "d") produced the error {repr(err)}`); }
try { int::big::format(-3.14, "d"); error "unreachable"; } catch err { println($`int::big::format(-3.14, "d") produced the error {repr(err)}`); }
try { int::big::format(+Inf, "d"); error "unreachable"; } catch err { println($`int::big::format(+Inf, "d") produced the error {repr(err)}`); }
try { int::big::format(-Inf, "d"); error "unreachable"; } catch err { println($`int::big::format(-Inf, "d") produced the error {repr(err)}`); }
try { int::big::format(NaN, "d"); error "unreachable"; } catch err { println($`int::big::format(NaN, "d") produced the error {repr(err)}`); }
