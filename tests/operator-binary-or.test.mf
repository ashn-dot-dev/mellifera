try { dumpln( null         or null          ); } catch err { dumpln(err); }
try { dumpln( true         or true          ); } catch err { dumpln(err); }
try { dumpln( 123          or 123           ); } catch err { dumpln(err); }
try { dumpln( "foo"        or "foo"         ); } catch err { dumpln(err); }
try { dumpln( []           or []            ); } catch err { dumpln(err); }
try { dumpln( Map{}        or Map{}         ); } catch err { dumpln(err); }
try { dumpln( Set{}        or Set{}         ); } catch err { dumpln(err); }
try { function(a, b){ a or b; }(123.&, 123.&); } catch err { dumpln(err); }
try { dumpln( function(){} or function(){}  ); } catch err { dumpln(err); }
try { dumpln( println      or println       ); } catch err { dumpln(err); }

print("\n");

dumpln(false or false);
dumpln(false or true);
dumpln(true or false);
dumpln(true or true);

print("\n");

# short circuiting
let boom = function() { error "boom"; };
try { println($`true or boom() is {true or boom()}`); } catch err { println($`true or boom() produced {repr(err)}`); }
try { println($`false or boom() is {false or boom()}`); } catch err { println($`false or boom() produced {repr(err)}`); }

print("\n");

# type checking where one side is not a boolean
let bad = 123;
try { println($`bad or true is {bad or true}`); } catch err { println($`bad or true produced {repr(err)}`); }
try { println($`bad or false is {bad or false}`); } catch err { println($`bad or false produced {repr(err)}`); }
try { println($`true or bad is {true or bad}`); } catch err { println($`true or bad produced {repr(err)}`); }
try { println($`false or bad is {false or bad}`); } catch err { println($`false or bad produced {repr(err)}`); }
################################################################################
# "attempted binary or operation with left-hand-side of type `null`"
# true
# "attempted binary or operation with left-hand-side of type `number`"
# "attempted binary or operation with left-hand-side of type `string`"
# "attempted binary or operation with left-hand-side of type `vector`"
# "attempted binary or operation with left-hand-side of type `map`"
# "attempted binary or operation with left-hand-side of type `set`"
# "attempted binary or operation with left-hand-side of type `reference`"
# "attempted binary or operation with left-hand-side of type `function`"
# "attempted binary or operation with left-hand-side of type `function`"
#
# false
# true
# true
# true
#
# true or boom() is true
# false or boom() produced "boom"
#
# bad or true produced "attempted binary or operation with left-hand-side of type `number`"
# bad or false produced "attempted binary or operation with left-hand-side of type `number`"
# true or bad is true
# false or bad produced "attempted binary or operation with right-hand-side of type `number`"
