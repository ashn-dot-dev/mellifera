try { dumpln( null         and null          ); } catch err { dumpln(err); }
try { dumpln( true         and true          ); } catch err { dumpln(err); }
try { dumpln( 123          and 123           ); } catch err { dumpln(err); }
try { dumpln( "foo"        and "foo"         ); } catch err { dumpln(err); }
try { dumpln( []           and []            ); } catch err { dumpln(err); }
try { dumpln( Map{}        and Map{}         ); } catch err { dumpln(err); }
try { dumpln( Set{}        and Set{}         ); } catch err { dumpln(err); }
try { function(a, b){ a and b; }(123.&, 123.&); } catch err { dumpln(err); }
try { dumpln( function(){} and function(){}  ); } catch err { dumpln(err); }
try { dumpln( println      and println       ); } catch err { dumpln(err); }

print("\n");

dumpln(false and false);
dumpln(false and true);
dumpln(true and false);
dumpln(true and true);

print("\n");

# short circuiting
let boom = function() { error "boom"; };
try { println($`true and boom() is {true and boom()}`); } catch err { println($`true and boom() produced {repr(err)}`); }
try { println($`false and boom() is {false and boom()}`); } catch err { println($`false and boom() produced {repr(err)}`); }

print("\n");

# type checking where one side is not a boolean
let bad = 123;
try { println($`bad and true is {bad and true}`); } catch err { println($`bad and true produced {repr(err)}`); }
try { println($`bad and false is {bad and false}`); } catch err { println($`bad and false produced {repr(err)}`); }
try { println($`true and bad is {true and bad}`); } catch err { println($`true and bad produced {repr(err)}`); }
try { println($`false and bad is {false and bad}`); } catch err { println($`false and bad produced {repr(err)}`); }
################################################################################
# "attempted binary and operation with left-hand-side of type `null`"
# true
# "attempted binary and operation with left-hand-side of type `number`"
# "attempted binary and operation with left-hand-side of type `string`"
# "attempted binary and operation with left-hand-side of type `vector`"
# "attempted binary and operation with left-hand-side of type `map`"
# "attempted binary and operation with left-hand-side of type `set`"
# "attempted binary and operation with left-hand-side of type `reference`"
# "attempted binary and operation with left-hand-side of type `function`"
# "attempted binary and operation with left-hand-side of type `function`"
#
# false
# false
# false
# true
#
# true and boom() produced "boom"
# false and boom() is false
#
# bad and true produced "attempted binary and operation with left-hand-side of type `number`"
# bad and false produced "attempted binary and operation with left-hand-side of type `number`"
# true and bad produced "attempted binary and operation with right-hand-side of type `number`"
# false and bad is false
