let x = {
    "foo": 123,
    "bar": 456,
    [{"abc", "def"}]: function() {},
};
dumpln(x.get("foo", "default"));
dumpln(x.get("bar", "default"));
dumpln(x.get("baz", "default"));
dumpln(x.get([{"abc", "def"}], "default"));
dumpln(x.get([{"def", "abc"}], "default"));
dumpln(x.get([{"abc": "def"}], "default"));
