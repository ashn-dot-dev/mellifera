let int = import("int");

println(int::u8::bit_or(0b10101100, 0b11110000).format("08b"));
println(int::u8::bit_or(int::u8::MIN, 0b11110000).format("08b"));
println(int::u8::bit_or(int::u8::MAX, 0b11110000).format("08b"));
println(int::s8::bit_or(int::s8::MAX, 0b01110000).format("08b"));

print("\n");

dumpln(int::s8::bit_or(-128, +1));
dumpln(int::s8::bit_or(-2, +1));
dumpln(int::s8::bit_or(-86, 0b01010101));
dumpln(int::s8::bit_or(int::s8::MIN, int::s8::MAX));
