let int = import("int");

println(int::big::sub(0, 0));
println(int::big::sub(0, +1));
println(int::big::sub(0, -1));
println(int::big::sub(+1, +1));
println(int::big::sub(-1, -1));
println(int::big::sub(+1, -1));

print("\n");

println(int::big::sub(+123, +456));
println(int::big::sub(+123, -456));
println(int::big::sub(-123, +456));
println(int::big::sub(-123, -456));

print("\n");

println(int::big::sub("+123123123123123123123123123123", "+45645645645645"));
println(int::big::sub("+123123123123123123123123123123", "-45645645645645"));
println(int::big::sub("-123123123123123123123123123123", "+45645645645645"));
println(int::big::sub("-123123123123123123123123123123", "-45645645645645"));
println(int::big::sub("+123123123123123123123123123123", "-123123123123123123123123123123"));
println(int::big::sub("+0x1000000000000000000000000", +1).format("#x"));
