let int = import("int");

dumpln(int::u8::add_checked(1, 2));
try { int::u8::add_checked(int::u8::MAX, 1); } catch err { dumpln(err); }

print("\n");

dumpln(int::s8::add_checked(-1, 2));
try { int::s8::add_checked(int::s8::MAX, +1); } catch err { dumpln(err); }
try { int::s8::add_checked(int::s8::MIN, -1); } catch err { dumpln(err); }
