let int = import("int");

println(int::big::add(0, 0));
println(int::big::add(0, +1));
println(int::big::add(0, -1));
println(int::big::add(+1, +1));
println(int::big::add(-1, -1));
println(int::big::add(+1, -1));

print("\n");

println(int::big::add(+123, +456));
println(int::big::add(+123, -456));
println(int::big::add(-123, +456));
println(int::big::add(-123, -456));

print("\n");

println(int::big::add("+123123123123123123123123123123", "+45645645645645"));
println(int::big::add("+123123123123123123123123123123", "-45645645645645"));
println(int::big::add("-123123123123123123123123123123", "+45645645645645"));
println(int::big::add("-123123123123123123123123123123", "-45645645645645"));
println(int::big::add("+123123123123123123123123123123", "-123123123123123123123123123123"));
println(int::big::add("+0xFFFFFFFFFFFFFFFFFFFFFFFF", +1).format("#x"));
