dumpln([1, 3, 5].reduce(function(accumulator, value) {
    return accumulator + value;
}));
dumpln([42].reduce(function(accumulator, value) {
    return accumulator + value;
}));

print("\n");

try { [1, 3, 5].reduce(function(nope) { }); } catch err { dumpln(err); }
try {
    [].reduce(function(accumulator, value) {
        return accumulator + value;
    });
} catch err {
    dumpln(err);
}
try {
    [1, "foo"].reduce(function(accumulator, value) {
        return accumulator + value;
    });
} catch err {
    dumpln(err);
}
