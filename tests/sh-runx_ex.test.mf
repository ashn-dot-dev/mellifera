try { dumpln(sh::runx_ex(`grep 'input line' && printf "sh::runx_ex stdout\n" && printf "sh::runx_ex stderr\n" >&2 && true`, {.stdin = "input line 1\ninput line2\n"})); } catch err { println($"error: {err}"); }
try { dumpln(sh::runx_ex(`grep 'input line' && printf "sh::runx_ex stdout\n" && printf "sh::runx_ex stderr\n" >&2 && false`, {.stdin = "input line 1\ninput line2\n"})); } catch err { println($"error: {err}"); }

print("\n");

try { dumpln(sh::runx_ex(`kill -TERM $$`, Map{})); } catch err { println($"error: {err}"); }

print("\n");

try { dumpln(sh::runx_ex(`printf 'empty options\n'`, Map{})); } catch err { println($"error: {err}"); }
try { dumpln(sh::runx_ex(`printf 'invalid options\n'`, Set{})); } catch err { println($"error: {err}"); }
try { dumpln(sh::runx_ex(`printf 'invalid option\n'`, {.foo = "bar"})); } catch err { println($"error: {err}"); }
try { dumpln(sh::runx_ex(`printf 'invalid option\n'`, {.stdin = null})); } catch err { println($"error: {err}"); }
